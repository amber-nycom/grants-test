
<!doctype html><html><head><meta charset=utf8><meta name=viewport content="width=device-width,initial-scale=1,viewport-fit=cover"><style>:root{color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}html{scroll-padding-top:env(safe-area-inset-top,0px)}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#fff;color:#000}img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}</style></head><body>
<title>NY Municipal Delegation Portal</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@700;800;900&family=JetBrains+Mono:wght@500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap">
<style>
/* Layout: navy masthead + stats strip, then one white-card workspace per tab (finder, summary, table). Senate = orange, Assembly = blue throughout. */
:root{
  --font-display:'Archivo','Arial Black',system-ui,sans-serif;
  --font-body:'Plus Jakarta Sans',system-ui,-apple-system,'Segoe UI',sans-serif;
  --font-mono:'JetBrains Mono',ui-monospace,SFMono-Regular,Menlo,monospace;
  --bg:#f5f7fb; --surface:#ffffff; --soft:#f6f8fb; --line:#e2e8f0; --line-strong:#cbd5e1;
  --ink:#0f1b2d; --muted:#64748b; --chip:#eaeff6;
  --hdr-a:#21497c; --hdr-b:#1b4072; --strip:#16345a; --on-hdr:#ffffff; --on-hdr-muted:#b4c6de;
  --hero-a:#1f4a7c; --hero-b:#153761;
  --sen:#c2562d; --sen-ink:#a9431c; --sen-tint:#fcebe2; --sen-solid:#c2562d;
  --asm:#1f4a7c; --asm-ink:#1f4a7c; --asm-tint:#e6edf6; --solid-navy:#1f4a7c;
  --dem:#2563eb; --dem-bg:#eff6ff; --dem-line:#bfdbfe;
  --rep:#dc2626; --rep-bg:#fef2f2; --rep-line:#fecaca;
  --shadow:0 1px 2px rgba(15,27,45,.05);
  --focus:#2563eb;
}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){
  --bg:#0b1220; --surface:#111b2e; --soft:#0e1727; --line:#23324a; --line-strong:#33465f;
  --ink:#e8eef8; --muted:#92a3bb; --chip:#1a283f;
  --hdr-a:#16294a; --hdr-b:#122242; --strip:#0d1a33; --hero-a:#1b3f6e; --hero-b:#122b50;
  --sen:#e47843; --sen-ink:#ffb48f; --sen-tint:#38231a; --sen-solid:#c2562d;
  --asm:#6ea3e6; --asm-ink:#aecdf5; --asm-tint:#172a45; --solid-navy:#2b5a96;
  --dem:#86b4ff; --dem-bg:#13284a; --dem-line:#264a82;
  --rep:#ff8f8f; --rep-bg:#3a1821; --rep-line:#6c2a37;
  --shadow:none; --focus:#8ab4ff; color-scheme:dark;}}
:root[data-theme="dark"]{
  --bg:#0b1220; --surface:#111b2e; --soft:#0e1727; --line:#23324a; --line-strong:#33465f;
  --ink:#e8eef8; --muted:#92a3bb; --chip:#1a283f;
  --hdr-a:#16294a; --hdr-b:#122242; --strip:#0d1a33; --hero-a:#1b3f6e; --hero-b:#122b50;
  --sen:#e47843; --sen-ink:#ffb48f; --sen-tint:#38231a; --sen-solid:#c2562d;
  --asm:#6ea3e6; --asm-ink:#aecdf5; --asm-tint:#172a45; --solid-navy:#2b5a96;
  --dem:#86b4ff; --dem-bg:#13284a; --dem-line:#264a82;
  --rep:#ff8f8f; --rep-bg:#3a1821; --rep-line:#6c2a37;
  --shadow:none; --focus:#8ab4ff; color-scheme:dark;}

*{box-sizing:border-box}
body{background:var(--bg);color:var(--ink);font-family:var(--font-body);font-size:14px;line-height:1.45;-webkit-font-smoothing:antialiased}
button{font:inherit;color:inherit;cursor:pointer;background:none;border:0;padding:0}
input{font:inherit;color:inherit}
h1,h2,h3,p{margin:0}
:focus-visible{outline:2px solid var(--focus);outline-offset:2px}
.ico{width:1em;height:1em;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;flex:none}
.wrap{max-width:1248px;margin-inline:auto;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}

/* masthead */
.top{background:linear-gradient(100deg,var(--hdr-a),var(--hdr-b));color:var(--on-hdr)}
.top .wrap{display:flex;align-items:center;justify-content:space-between;gap:16px 24px;flex-wrap:wrap;padding-block:18px}
.brand{display:flex;align-items:center;gap:16px;min-width:0}
.logo{font-family:var(--font-display);font-weight:900;font-size:27px;letter-spacing:.015em;line-height:1}
.brand .bar{width:1px;align-self:stretch;min-height:36px;background:rgba(255,255,255,.28)}
.brand h1{font-family:var(--font-display);font-weight:700;font-size:19px;line-height:1.15;text-wrap:balance}
.brand p{font-size:12.5px;color:var(--on-hdr-muted);margin-top:2px}
.nav{display:flex;gap:4px;padding:4px;border:1px solid rgba(255,255,255,.15);background:rgba(8,22,46,.35);border-radius:11px}
.nav button{display:flex;align-items:center;gap:7px;padding:9px 13px;border-radius:8px;font-size:13px;font-weight:600;color:var(--on-hdr);line-height:1.2;text-align:left}
.nav button:hover{background:rgba(255,255,255,.1)}
.nav button[aria-selected="true"]{background:var(--sen-solid);box-shadow:0 1px 2px rgba(0,0,0,.25)}
.nav .ico{font-size:15px}
.strip{background:var(--strip);color:var(--on-hdr-muted);font-size:12.5px}
.strip .wrap{display:flex;flex-wrap:wrap;align-items:center;gap:6px 26px;padding-block:11px}
.strip .it{display:flex;align-items:center;gap:7px;white-space:nowrap}
.strip .it+.it{padding-left:26px;border-left:1px solid rgba(255,255,255,.14)}
.strip .ico{font-size:16px;color:#e9885c}
.strip b{color:var(--on-hdr);font-weight:700;font-variant-numeric:tabular-nums}
.strip small{font-size:11.5px;opacity:.85}
.strip .dot{width:8px;height:8px;border-radius:50%;display:inline-block}
.strip .dem .dot{background:#4f8cff}.strip .rep .dot{background:#ef5757}

/* generic */
main{padding-block:26px 40px;display:grid;gap:26px}
[hidden]{display:none!important}
body{margin:0}
.panel{display:grid;gap:26px}
.card{background:var(--surface);border:1px solid var(--line);border-radius:14px;box-shadow:var(--shadow)}
.picker{padding:22px 24px 20px;display:grid;gap:16px}
.eyebrow{font-size:11.5px;font-weight:700;letter-spacing:.07em;text-transform:uppercase;color:var(--muted)}
.chiprow{display:flex;flex-wrap:wrap;align-items:center;gap:8px;padding-top:16px;border-top:1px solid var(--line)}
.chiprow .lead{display:flex;align-items:center;gap:6px;font-size:12px;font-weight:600;color:var(--muted);margin-right:2px}
.quick{padding:6px 13px;border-radius:999px;background:var(--chip);font-size:12.5px;font-weight:600;color:var(--ink)}
.quick:hover{background:var(--line)}
.quick.on{background:var(--sen-solid);color:#fff}
.borows{display:flex;flex-wrap:wrap;align-items:center;gap:8px}

/* combobox */
.combo{position:relative;display:grid;gap:8px}
.combo-btn{display:flex;align-items:center;gap:10px;width:100%;min-height:48px;padding:8px 14px;border:1px solid var(--line-strong);border-radius:9px;background:var(--soft);text-align:left;min-width:0}
.combo-btn:hover{border-color:var(--muted)}
.combo-btn .lead{color:var(--sen);font-size:16px}
.combo-btn .val{display:flex;align-items:center;gap:9px;flex:1;min-width:0;flex-wrap:wrap}
.combo-btn .chev{color:var(--muted);font-size:17px;transition:transform .15s}
.combo-btn[aria-expanded="true"] .chev{transform:rotate(180deg)}
.combo-panel{position:absolute;left:0;right:0;top:calc(100% + 6px);z-index:30;background:var(--surface);border:1px solid var(--line-strong);border-radius:11px;box-shadow:0 14px 34px rgba(8,20,40,.22);overflow:hidden}
.combo-panel input{width:100%;border:0;border-bottom:1px solid var(--line);padding:12px 14px;background:var(--surface);outline:none}
.combo-panel ul{list-style:none;margin:0;padding:6px;max-height:min(320px,50vh);overflow-y:auto}
.combo-panel li{display:flex;align-items:center;gap:9px;flex-wrap:wrap;padding:8px 10px;border-radius:7px;cursor:pointer}
.combo-panel li.act{background:var(--chip)}
.combo-panel li.sel .nm{color:var(--sen)}
.combo-panel li.none{color:var(--muted);cursor:default}
.nm{font-weight:700}

/* chips */
.pill{display:inline-flex;align-items:center;padding:2px 9px;border-radius:999px;background:var(--chip);color:var(--muted);font-size:12px;font-weight:600;white-space:nowrap}
.dist{display:inline-flex;font-family:var(--font-mono);font-size:12px;font-weight:600;padding:3px 9px;border-radius:5px;background:var(--solid-navy);color:#fff;white-space:nowrap}
.pty{display:inline-flex;align-items:center;gap:6px;padding:2px 9px;border-radius:999px;font-size:12px;font-weight:600;border:1px solid;white-space:nowrap}
.pty::before{content:"";width:6px;height:6px;border-radius:50%;background:currentColor}
.pty.D{color:var(--dem);background:var(--dem-bg);border-color:var(--dem-line)}
.pty.R{color:var(--rep);background:var(--rep-bg);border-color:var(--rep-line)}
.ch{display:inline-flex;padding:2px 9px;border-radius:5px;font-size:12px;font-weight:600}
.ch.Senate{background:var(--sen-tint);color:var(--sen-ink)}
.ch.Assembly{background:var(--asm-tint);color:var(--asm-ink)}
.cls{display:inline-flex;padding:3px 9px;border-radius:5px;background:var(--chip);color:var(--asm-ink);font-size:11px;font-weight:700;letter-spacing:.06em;text-transform:uppercase}

/* hero */
.hero{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:18px 24px;padding:26px 30px;border-radius:16px;color:#fff;background:linear-gradient(120deg,var(--hero-a),var(--hero-b));box-shadow:0 8px 24px rgba(15,40,80,.18)}
.hero-l{min-width:0;display:grid;gap:10px}
.hero-top{display:flex;flex-wrap:wrap;align-items:center;gap:9px;font-size:13px;color:#c7d6ea}
.htag{display:inline-flex;padding:3px 10px;border-radius:5px;font-size:11.5px;font-weight:800;letter-spacing:.07em;text-transform:uppercase;color:#fff}
.htag.sen{background:var(--sen-solid)}.htag.asm{background:#3b7bc4}
.htag.navy{background:rgba(7,20,44,.55);border:1px solid rgba(255,255,255,.2)}
.htag.dem{background:#eaf1ff;color:#1d4fc4}.htag.rep{background:#feecec;color:#b42323}
.hero h2{font-family:var(--font-display);font-weight:800;font-size:clamp(30px,5.4vw,42px);line-height:1.05;display:flex;flex-wrap:wrap;align-items:baseline;gap:6px 14px;letter-spacing:-.005em}
.hero h2 small{font-family:var(--font-body);font-weight:500;font-size:14px;color:#c7d6ea;letter-spacing:0}
.scope{border:1px solid rgba(255,255,255,.2);border-radius:11px;padding:11px 18px;background:rgba(7,20,44,.28);display:grid;gap:3px}
.scope .eyebrow{color:#b4c6de;font-size:10.5px}
.scope b{font-size:15px;font-weight:700;white-space:nowrap}
.scope .o{color:#ffb894}

/* chamber columns */
.cols{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}
.col{display:grid;gap:16px;align-content:start;min-width:0}
.colhead{display:flex;align-items:flex-end;justify-content:space-between;gap:12px;padding-bottom:11px;border-bottom:2px solid}
.colhead.Senate{border-color:var(--sen)}.colhead.Assembly{border-color:var(--asm)}
.colhead h3{font-family:var(--font-display);font-weight:800;font-size:17px}
.colhead p{font-size:12.5px;color:var(--muted)}
.count{font-size:12px;font-weight:600;color:var(--muted);background:var(--chip);padding:3px 11px;border-radius:999px;white-space:nowrap}
.rep{padding:20px;display:grid;gap:14px;min-width:0}
.rep-tags{display:flex;flex-wrap:wrap;gap:8px}
.rep h4{margin:0;font-family:var(--font-display);font-weight:700;font-size:21px;line-height:1.15;text-wrap:balance}
.cov{background:var(--soft);border:1px solid var(--line);border-radius:9px;padding:10px 13px;display:grid;gap:9px}
.cov-row{display:grid;gap:6px}
.cov-top{display:flex;align-items:center;justify-content:space-between;gap:10px;font-size:12.5px;font-weight:600;color:var(--muted)}
.cov-top span{display:flex;align-items:center;gap:6px;min-width:0}
.cov-top .ico{color:var(--sen);flex:none}
.cov-top b{font-family:var(--font-mono);font-size:12.5px;color:var(--ink);font-weight:600}
.track{height:7px;border-radius:99px;background:var(--line)}
.track i{display:block;height:100%;border-radius:99px;min-width:3px}
.track i.Senate{background:var(--sen)}.track i.Assembly{background:var(--asm)}
.link{display:inline-flex;align-items:center;gap:6px;font-size:13px;font-weight:600;color:var(--asm-ink);text-align:left}
.link:hover{text-decoration:underline}
.link .ico{font-size:13px;flex:none}
.empty{padding:26px;border:1px dashed var(--line-strong);border-radius:12px;color:var(--muted);text-align:center}

/* filter bars + segmented controls */
.bar-card{padding:14px 18px;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:12px 20px}
.search{position:relative;flex:1 1 280px;max-width:400px}
.search .ico{position:absolute;left:12px;top:50%;transform:translateY(-50%);color:var(--muted);font-size:15px}
.search input{width:100%;padding:10px 12px 10px 36px;border:1px solid var(--line-strong);border-radius:9px;background:var(--soft)}
.search input:focus{outline:2px solid var(--focus);outline-offset:1px}
.filters{display:flex;flex-wrap:wrap;align-items:center;gap:10px 22px}
.fgroup{display:flex;align-items:center;gap:8px;font-size:12.5px;font-weight:600;color:var(--muted)}
.fgroup>.ico{font-size:14px}
.seg{display:inline-flex;gap:2px;padding:3px;background:var(--chip);border-radius:9px}
.seg button{padding:5px 11px;border-radius:7px;font-size:12.5px;font-weight:600;color:var(--muted)}
.seg button:hover{color:var(--ink)}
.seg button.on{background:var(--solid-navy);color:#fff}
.seg.warm button.on{background:var(--sen-solid)}
.meta{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:10px;font-size:12.5px;color:var(--muted)}
.meta b{color:var(--ink);font-variant-numeric:tabular-nums}

/* summary grid */
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,290px),1fr));gap:16px}
.mcard{padding:18px 20px;display:grid;gap:12px;align-content:start;min-width:0}
.mcard h4{margin:0;font-family:var(--font-display);font-weight:700;font-size:19px;line-height:1.15}
.mcard .note{font-size:12px;color:var(--muted)}
.mcard .foot{border-top:1px solid var(--line);padding-top:12px;margin-top:2px}

/* table */
.tablecard{overflow:hidden}
.scroller{overflow-x:auto}
table{width:100%;border-collapse:collapse;min-width:820px}
thead th{background:var(--hero-a);color:#fff;text-align:left;font-size:11.5px;font-weight:700;letter-spacing:.07em;text-transform:uppercase;padding:14px 16px;white-space:nowrap}
thead th:last-child,tbody td:last-child{text-align:right}
tbody td{padding:13px 16px;border-top:1px solid var(--line);vertical-align:middle}
tbody tr:first-child td{border-top:0}
tbody tr:hover{background:var(--soft)}
td.off{font-weight:700;white-space:nowrap}
td.dnum{font-family:var(--font-mono);font-size:12.5px;color:var(--asm-ink);font-weight:600}
td.cl{color:var(--muted)}
.mlink{display:inline-flex;align-items:center;gap:5px;font-weight:600;color:var(--asm-ink)}
.mlink:hover{text-decoration:underline}
.mlink .ico{font-size:13px}
.mlink+.sub{margin-left:6px;font-size:12px;color:var(--muted)}
.pcell{display:inline-flex;align-items:center;gap:10px;justify-content:flex-end}
.pcell b{font-family:var(--font-mono);font-size:12.5px;font-weight:600;font-variant-numeric:tabular-nums}
.pcell .track{width:56px}
.pager{display:flex;align-items:center;justify-content:center;gap:14px;font-size:12.5px;color:var(--muted)}
.pager button{padding:7px 14px;border:1px solid var(--line-strong);border-radius:8px;font-weight:600;color:var(--ink);background:var(--surface)}
.pager button:disabled{opacity:.4;cursor:default}
.src{font-size:12px;color:var(--muted);max-width:80ch}

@media (max-width:860px){
  .cols{grid-template-columns:minmax(0,1fr)}
}
@media (max-width:720px){
  .top .wrap{align-items:stretch}
  .brand{width:100%}
  .nav{width:100%}
  .nav button{flex:1;justify-content:center;text-align:center;padding:9px 6px;font-size:12.5px}
  .nav .ico{display:none}
  .strip .it+.it{padding-left:0;border-left:0}
  .strip .wrap{gap:6px 18px}
  .picker{padding:18px 16px}
  .hero{padding:22px 20px}
  .logo{font-size:23px}
  .brand h1{font-size:17px}
}
@media (prefers-reduced-motion:reduce){*{transition:none!important}}
</style>

<header class="top">
  <div class="wrap">
    <div class="brand">
      <div class="logo">NYCOM</div>
      <div class="bar" aria-hidden="true"></div>
      <div>
        <h1>NY Municipal Delegation Portal</h1>
        <p>Direct Senate &amp; Assembly representation finder for local municipal leaders</p>
      </div>
    </div>
    <nav class="nav" role="tablist" aria-label="Portal views">
      <button role="tab" id="tab-finder" data-tab="finder" aria-selected="true"><svg class="ico" viewBox="0 0 24 24"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>Municipality Finder</button>
      <button role="tab" id="tab-summary" data-tab="summary" aria-selected="false"><svg class="ico" viewBox="0 0 24 24"><path d="M3 22h18M6 18v-7M10 18v-7M14 18v-7M18 18v-7M12 2l8 5H4l8-5Z"/></svg>Representative Summary</button>
      <button role="tab" id="tab-all" data-tab="all" aria-selected="false"><svg class="ico" viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>All Representatives</button>
    </nav>
  </div>
</header>
<div class="strip">
  <div class="wrap" id="stats"></div>
</div>

<main class="wrap">
  <!-- Municipality Finder -->
  <section class="panel" id="p-finder" role="tabpanel" aria-labelledby="tab-finder">
    <div class="card picker">
      <div class="combo" id="muniCombo">
        <label class="eyebrow" id="muniLbl">Select or search your city or village</label>
        <button type="button" class="combo-btn" aria-haspopup="listbox" aria-expanded="false" aria-labelledby="muniLbl"></button>
        <div class="combo-panel" hidden>
          <input type="search" placeholder="Type a city or village name" aria-label="Search municipalities" autocomplete="off">
          <ul role="listbox"></ul>
        </div>
      </div>
      <div class="chiprow" id="quickRow"><span class="lead"><svg class="ico" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="m16 8-2 6-6 2 2-6 6-2Z"/></svg>Quick select:</span></div>
      <div class="chiprow" id="boroRow" hidden><span class="lead">Borough:</span></div>
    </div>
    <div id="finderOut" class="panel"></div>
  </section>

  <!-- Representative Summary -->
  <section class="panel" id="p-summary" role="tabpanel" aria-labelledby="tab-summary" hidden>
    <div class="card picker">
      <div class="combo" id="repCombo">
        <label class="eyebrow" id="repLbl">Select or search a state representative</label>
        <button type="button" class="combo-btn" aria-haspopup="listbox" aria-expanded="false" aria-labelledby="repLbl"></button>
        <div class="combo-panel" hidden>
          <input type="search" placeholder="Type a name, district or party" aria-label="Search representatives" autocomplete="off">
          <ul role="listbox"></ul>
        </div>
      </div>
      <div class="chiprow" id="featRow"><span class="lead"><svg class="ico" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="m16 8-2 6-6 2 2-6 6-2Z"/></svg>Legislative leaders:</span></div>
    </div>
    <div id="sumHero"></div>
    <div class="card bar-card">
      <div class="search"><svg class="ico" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg><input id="sumQ" type="search" placeholder="Search within represented municipalities..." aria-label="Search within represented municipalities" autocomplete="off"></div>
      <div class="filters">
        <div class="fgroup">Type:
          <div class="seg" id="sumType"><button class="on" data-val="All">All Types</button><button data-val="City">Cities</button><button data-val="Village">Villages</button></div>
        </div>
        <span class="meta" id="sumCount"></span>
      </div>
    </div>
    <div id="sumGrid" class="grid"></div>
  </section>

  <!-- All Representatives -->
