const QUICK=['Albany','Buffalo','Rochester','Syracuse','Yonkers','New York City','White Plains','Hempstead'].filter(n=>munis.has(n));
$('#quickRow').insertAdjacentHTML('beforeend',QUICK.map(n=>'<button type="button" class="quick" data-quick="'+esc(n)+'">'+esc(n)+'</button>').join(''));
