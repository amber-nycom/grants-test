/* ---------- Municipality Finder ---------- */
function covRows(entries,ch,single){
  return entries.map(e=>{
    const label=e.boro?'Share of '+esc(e.boro)+':':'Territory Coverage in Municipality:';
    return '<div class="cov-row"><div class="cov-top"><span>'+ico('percent')+label+'</span><b>'+pct(e.pct)+'</b></div>'+bar(e.pct,ch)+'</div>';
  }).join('');
}
function finderGroups(m,boro){
  const g=new Map();
  m.rows.forEach(r=>{
    if(m.nyc&&boro&&boro!=='All'&&r.boro!==boro) return;
    let x=g.get(rkey(r)); if(!x){x={rep:reps.get(rkey(r)),entries:[]};g.set(x.rep.key,x);} x.entries.push({boro:r.boro,pct:r.pct});
  });
  const top=x=>Math.max(...x.entries.map(e=>e.pct));
  return [...g.values()].sort((a,b)=>top(b)-top(a)||a.rep.name.localeCompare(b.rep.name));
}
function repCard(g){
  const p=g.rep;
  return '<article class="card rep"><div class="rep-tags"><span class="dist">'+p.ch+' District '+p.d+'</span>'+ptyChip(p.party)+'</div>'+
   '<h4>'+titleOf(p)+' '+esc(p.name)+'</h4>'+
   '<div class="cov">'+covRows(g.entries,p.ch)+'</div>'+
   '<button type="button" class="link" data-act="rep" data-rep="'+esc(p.key)+'">View all municipalities represented by '+esc(p.name)+ico('arrow')+'</button></article>';
}
function renderFinder(){
  const m=munis.get(S.muni);
  muniCombo.set(m.name);
  $('#boroRow').hidden=!m.nyc;
  document.querySelectorAll('[data-quick]').forEach(b=>b.classList.toggle('on',b.dataset.quick===m.name));
  document.querySelectorAll('[data-boro]').forEach(b=>b.classList.toggle('on',b.dataset.boro===S.boro));
  const groups=finderGroups(m,m.nyc?S.boro:null);
  const sen=groups.filter(g=>g.rep.ch==='Senate'),asm=groups.filter(g=>g.rep.ch==='Assembly');
  const where=m.nyc&&S.boro!=='All'?' · '+S.boro:'';
  const col=(ch,arr,t,sub)=>'<div class="col"><div class="colhead '+ch+'"><div><h3>'+t+'</h3><p>'+sub+'</p></div><span class="count">'+plural(arr.length,'Representative')+'</span></div>'+
    (arr.length?arr.map(repCard).join(''):'<div class="empty">No '+ch+' representation on record for this municipality.</div>')+'</div>';
  $('#finderOut').innerHTML=
   '<div class="hero"><div class="hero-l"><div class="hero-top"><span class="htag sen">'+m.cls+'</span><span>New York State Representation'+esc(where)+'</span></div>'+
   '<h2>'+esc(m.name)+'<small>('+plural(groups.length,'Legislative Seat')+')</small></h2></div>'+
   '<div class="scope"><span class="eyebrow">Chamber division</span><b><span class="o">'+sen.length+' Senate</span> &nbsp;|&nbsp; '+asm.length+' Assembly</b></div></div>'+
   '<div class="cols">'+col('Senate',sen,'New York State Senate','Upper Legislative Chamber')+col('Assembly',asm,'New York State Assembly','Lower Legislative Chamber')+'</div>';
}
function selectMuni(name,boro){
  if(!munis.has(name)) return;
  S.muni=name; if(boro) S.boro=boro; renderFinder();
}

/* ---------- Representative Summary ---------- */
function renderSumHero(){
  const p=reps.get(S.rep);
  repCombo.set(p.key);
  document.querySelectorAll('[data-feat]').forEach(b=>b.classList.toggle('on',b.dataset.feat===p.key));
  $('#sumHero').innerHTML='<div class="hero"><div class="hero-l"><div class="hero-top">'+
   '<span class="htag '+(p.ch==='Senate'?'sen':'asm')+'">'+(p.ch==='Senate'?'State Senator':'State Assembly Member')+'</span>'+
   '<span class="htag navy">'+p.ch+' District '+p.d+'</span><span class="htag '+(p.party==='Democratic'?'dem':'rep')+'">'+p.party+'</span></div>'+
   '<h2>'+esc(p.name)+'<small>(Representing '+plural(p.munis.length,'Municipality','Municipalities')+')</small></h2></div>'+
   '<div class="scope"><span class="eyebrow">Local constituency scope</span><b><span class="o">'+plural(p.cities,'City','Cities')+'</span> &nbsp;|&nbsp; '+plural(p.villages,'Village')+'</b></div></div>';
  renderSumGrid();
}
function renderSumGrid(){
  const p=reps.get(S.rep),q=S.sumQ.trim().toLowerCase();
  const list=p.munis.filter(x=>(S.sumType==='All'||x.cls===S.sumType)&&(!q||x.name.toLowerCase().includes(q)||x.entries.some(e=>e.boro.toLowerCase().includes(q))));
  $('#sumCount').textContent='('+plural(list.length,'municipality','municipalities')+' shown)';
  $('#sumGrid').innerHTML=list.length?list.map(x=>{
    const cr=x.entries.map(e=>{
      const area=e.boro?'of '+esc(e.boro):'of '+x.cls.toLowerCase()+' geographic area';
      return '<div class="cov-row"><div class="cov-top"><span>'+ico('percent')+(e.boro?esc(e.boro)+':':'Coverage:')+'</span><b>'+pct(e.pct)+'</b></div>'+bar(e.pct,p.ch)+'<span class="note">'+pct(e.pct)+' '+area+'</span></div>';
    }).join('');
    return '<article class="card mcard"><div><span class="cls">'+x.cls+'</span></div><h4>'+esc(x.name)+'</h4><div class="cov">'+cr+'</div>'+
     '<div class="foot"><button type="button" class="link" data-act="muni" data-muni="'+esc(x.name)+'" data-boro="'+esc(x.entries[0].boro)+'">Open in Municipality Finder'+ico('arrow')+'</button></div></article>';
  }).join(''):'<div class="empty" style="grid-column:1/-1">No municipalities match this search.</div>';
}
function selectRep(key){ if(!reps.has(key))return; S.rep=key; S.sumQ=''; $('#sumQ').value=''; renderSumHero(); }

/* ---------- All Representatives ---------- */
function filteredRows(){
  const A=S.all,q=A.q.trim().toLowerCase();
  return rows.filter(r=>(A.ch==='All'||r.ch===A.ch)&&(A.party==='All'||r.party===A.party)&&(!q||r.hay.includes(q)));
}
function renderAll(){
  const A=S.all,f=filteredRows(),total=f.length;
  const per=A.per==='all'?Math.max(total,1):+A.per, pages=Math.max(1,Math.ceil(total/per));
  A.page=Math.min(A.page,pages-1);
  const start=A.page*per,end=Math.min(total,start+per);
  $('#allMeta').innerHTML=total?'Showing <b>'+(start+1)+'</b> to <b>'+end+'</b> of <b>'+total+'</b> representative records':'No representative records match these filters.';
  $('#allBody').innerHTML=f.slice(start,end).map(r=>
   '<tr><td class="off">'+esc(r.name)+'</td><td><span class="ch '+r.ch+'">'+r.ch+'</span></td><td class="dnum">#'+r.d+'</td><td>'+ptyChip(r.party)+'</td>'+
   '<td><button type="button" class="mlink" data-act="muni" data-muni="'+esc(r.muni)+'" data-boro="'+esc(r.boro)+'">'+esc(r.muni)+ico('arrow')+'</button>'+(r.boro?'<span class="sub">'+esc(r.boro)+'</span>':'')+'</td>'+
   '<td class="cl">'+r.cls+'</td><td><span class="pcell"><b>'+pct(r.pct)+'</b>'+bar(r.pct,r.ch)+'</span></td></tr>').join('')||'<tr><td colspan="7" class="cl" style="text-align:center;padding:28px">Nothing to show. Clear the search or filters.</td></tr>';
  $('#pager').innerHTML=pages>1?'<button type="button" data-page="-1"'+(A.page===0?' disabled':'')+'>Previous</button><span>Page <b>'+(A.page+1)+'</b> of '+pages+'</span><button type="button" data-page="1"'+(A.page>=pages-1?' disabled':'')+'>Next</button>':'';
}

/* ---------- tabs + events ---------- */
const TABS=['finder','summary','all'];
function goTab(t,opts){
  if(!TABS.includes(t)) t='finder';
  S.tab=t;
  TABS.forEach(n=>{
    $('#p-'+n).hidden=n!==t;
    const b=$('#tab-'+n); b.setAttribute('aria-selected',String(n===t)); b.tabIndex=n===t?0:-1;
  });
  try{ if(location.hash.slice(1)!==t) history.replaceState(null,'','#'+t); }catch(e){}
  if(opts&&opts.scroll){ try{window.scrollTo({top:0});}catch(e){} }
}
document.querySelector('.nav').addEventListener('click',e=>{const b=e.target.closest('[data-tab]');if(b)goTab(b.dataset.tab);});
document.addEventListener('click',e=>{
  const q=e.target.closest('[data-quick]'); if(q){selectMuni(q.dataset.quick);return;}
  const f=e.target.closest('[data-feat]'); if(f){selectRep(f.dataset.feat);return;}
  const b=e.target.closest('[data-boro]'); if(b&&b.classList.contains('quick')){S.boro=b.dataset.boro;renderFinder();return;}
  const a=e.target.closest('[data-act]');
  if(a&&a.dataset.act==='rep'){selectRep(a.dataset.rep);goTab('summary',{scroll:true});}
  else if(a&&a.dataset.act==='muni'){selectMuni(a.dataset.muni,a.dataset.boro||null);goTab('finder',{scroll:true});}
  const pg=e.target.closest('[data-page]'); if(pg){S.all.page+=+pg.dataset.page;renderAll();}
});
$('#sumType').addEventListener('click',e=>{
  const b=e.target.closest('button[data-val]'); if(!b)return;
  S.sumType=b.dataset.val; document.querySelectorAll('#sumType button').forEach(x=>x.classList.toggle('on',x===b)); renderSumGrid();
});
$('#sumQ').addEventListener('input',e=>{S.sumQ=e.target.value;renderSumGrid();});
['segChamber','segParty','segPer'].forEach(id=>{
  $('#'+id).addEventListener('click',e=>{
    const b=e.target.closest('button[data-val]'); if(!b)return;
    S.all[$('#'+id).dataset.key]=b.dataset.val; S.all.page=0;
    document.querySelectorAll('#'+id+' button').forEach(x=>x.classList.toggle('on',x===b)); renderAll();
  });
});
$('#allQ').addEventListener('input',e=>{S.all.q=e.target.value;S.all.page=0;renderAll();});
window.addEventListener('hashchange',()=>goTab(location.hash.slice(1)));

/* ---------- boot ---------- */
renderFinder(); renderSumHero(); renderAll();
goTab(TABS.includes(location.hash.slice(1))?location.hash.slice(1):'finder');
})();
</script>

