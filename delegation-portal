/* ---------- combobox ---------- */
function Combo(root,cfg){
  const btn=root.querySelector('.combo-btn'),panel=root.querySelector('.combo-panel'),input=panel.querySelector('input'),list=panel.querySelector('ul');
  let shown=[],active=0,cur=null;
  const isOpen=()=>!panel.hidden;
  function fill(){
    const q=input.value.trim().toLowerCase();
    shown=cfg.items.filter(i=>!q||i.hay.includes(q));
    list.innerHTML=shown.length?shown.map((i,n)=>'<li role="option" data-i="'+n+'" class="'+(i.id===cur?'sel':'')+'">'+cfg.render(i)+'</li>').join(''):'<li class="none">No matches</li>';
    active=Math.max(0,shown.findIndex(i=>i.id===cur)); if(q) active=0; mark(true);
  }
  function mark(scroll){
    [...list.children].forEach((li,n)=>li.classList.toggle('act',n===active));
    if(scroll&&list.children[active]) list.children[active].scrollIntoView({block:'nearest'});
  }
  function open(){panel.hidden=false;btn.setAttribute('aria-expanded','true');input.value='';fill();input.focus();}
  function close(focus){panel.hidden=true;btn.setAttribute('aria-expanded','false');if(focus)btn.focus();}
  function pick(i){close(true);cfg.onPick(i.id);}
  btn.addEventListener('click',()=>isOpen()?close():open());
  input.addEventListener('input',fill);
  input.addEventListener('keydown',e=>{
    if(e.key==='ArrowDown'){e.preventDefault();active=Math.min(shown.length-1,active+1);mark(true);}
    else if(e.key==='ArrowUp'){e.preventDefault();active=Math.max(0,active-1);mark(true);}
    else if(e.key==='Enter'){e.preventDefault();if(shown[active])pick(shown[active]);}
    else if(e.key==='Escape'){e.preventDefault();close(true);}
  });
  list.addEventListener('click',e=>{const li=e.target.closest('li[data-i]');if(li)pick(shown[+li.dataset.i]);});
  list.addEventListener('mousemove',e=>{const li=e.target.closest('li[data-i]');if(li&&+li.dataset.i!==active){active=+li.dataset.i;mark(false);}});
  document.addEventListener('pointerdown',e=>{if(isOpen()&&!root.contains(e.target))close();});
  return {set(id){cur=id;const i=cfg.items.find(x=>x.id===id);btn.innerHTML=cfg.lead+'<span class="val">'+cfg.btn(i)+'</span><span class="chev">'+ico('chev')+'</span>';}};
}
