/* ---------- data model ---------- */
const BOROS=['Manhattan','Bronx','Brooklyn','Queens','Staten Island'];
const rows=RAW.map(r=>({muni:r[0],cls:r[1]==='C'?'City':'Village',ch:r[2]==='S'?'Senate':'Assembly',d:r[3],name:r[4],party:r[5]==='D'?'Democratic':'Republican',pct:r[6],boro:r[7]||''}));
const munis=new Map(), reps=new Map();
const rkey=r=>r.ch+'|'+r.d+'|'+r.name;
rows.forEach(r=>{
  let m=munis.get(r.muni); if(!m){m={name:r.muni,cls:r.cls,rows:[],nyc:false};munis.set(r.muni,m);} m.rows.push(r); if(r.boro) m.nyc=true;
  const k=rkey(r); let p=reps.get(k); if(!p){p={key:k,ch:r.ch,d:r.d,name:r.name,party:r.party,rows:[]};reps.set(k,p);} p.rows.push(r);
  r.hay=(r.name+' '+r.muni+' '+r.boro+' '+r.ch+' '+r.d+' '+r.party+' '+r.cls).toLowerCase();
});
reps.forEach(p=>{
  const g=new Map();
  p.rows.forEach(r=>{let x=g.get(r.muni); if(!x){x={name:r.muni,cls:r.cls,entries:[]};g.set(r.muni,x);} x.entries.push({boro:r.boro,pct:r.pct});});
  p.munis=[...g.values()].sort((a,b)=>a.name.localeCompare(b.name));
  p.cities=p.munis.filter(x=>x.cls==='City').length; p.villages=p.munis.length-p.cities;
});
const lastName=n=>{const t=n.replace(/,?\s+(Jr\.?|Sr\.?|II|III|IV)$/i,'').split(/\s+/);return t[t.length-1];};
const muniList=[...munis.values()].sort((a,b)=>a.name.localeCompare(b.name));
const repList=[...reps.values()].sort((a,b)=>lastName(a.name).localeCompare(lastName(b.name))||a.name.localeCompare(b.name));
